# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API. The site runs fine without them;
# forms will simply log submissions to the terminal until these are set.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Either the new "publishable" key or the legacy "anon" key works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the login page sends people after they sign in.
NEXT_PUBLIC_AFTER_LOGIN_URL=/
