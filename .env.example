# Next.js frontend. All application requests go through the Django API.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Production Vercel server-side settings (leave blank for local development).
# DJANGO_API_ORIGIN is used by the same-origin /api/v1 rewrite.
# DJANGO_API_URL is server-only and is used by public form proxy handlers.
DJANGO_API_ORIGIN=
DJANGO_API_URL=
